MAIN_AGENT_URL=http://localhost:8000
MAIN_AGENT_TIMEOUT_SECONDS=45
# Optional service credential used by the Proxy when calling Main Agent.
# MAIN_AGENT_BEARER_TOKEN=
# Forward the browser Authorization header only when the upstream trusts the same user token.
# A2UI_FORWARD_AUTHORIZATION=false

A2UI_SELECTION_TTL_SECONDS=300
A2UI_SELECTION_MAX_ENTRIES=100

# Required for the Proxy-owned A2UI template selection and field mapping.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
A2UI_AI_TIMEOUT_SECONDS=100
A2UI_FLOW_LOG_MAX_CHARS=50000
# Payload bodies are omitted from flow logs by default.
# A2UI_FLOW_LOG_INCLUDE_PAYLOADS=false
# Internal exception details are hidden from browser SSE errors by default.
# A2UI_EXPOSE_ERROR_DETAILS=false

# Standalone server settings used by run.py.
A2UI_PROXY_HOST=0.0.0.0
A2UI_PROXY_PORT=8200
# Comma-separated browser origins. Set the deployed Chatbot origin explicitly.
A2UI_PROXY_ALLOWED_ORIGINS=http://localhost:3001
# A2UI_PROXY_ALLOW_CREDENTIALS=false
# A2UI_PROXY_RELOAD=true
