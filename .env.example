OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional A2UI surface planner attempt tuning. Defaults to 6000 tokens, json_schema, 2 attempts.
# A2UI_AI_SURFACE_PLANNER_MAX_TOKENS=6000
# A2UI_AI_SURFACE_PLANNER_ATTEMPTS=2
# A2UI_AI_SURFACE_PLANNER_RESPONSE_FORMAT=json_schema

# Optional external equipment source overrides. Leave unset to use local fixtures.
# A2UI_EQUIPMENT_STATUS_API_URL=http://localhost:8100/equipment-status
# A2UI_EQUIPMENT_CATALOG_API_URL=http://localhost:8100/equipment-catalog

# Browser-visible Proxy Agent URL. Next.js inlines NEXT_PUBLIC_ values at build time.
# Leave unset for the local default http://localhost:8200.
# NEXT_PUBLIC_A2UI_PROXY_AGENT_URL=http://localhost:8200

# Optional local server URL overrides. Leave unset for the default dev ports.
# Use the replaceable work-items JSON without calling Main Agent.
# MAIN_AGENT_MODE=mock
# MOCK_MAIN_AGENT_DATA_FILE=mock-data/work-items.json
# Set MAIN_AGENT_MODE=remote to use the real Main Agent settings below.
# MAIN_AGENT_URL=http://localhost:8000
# MAIN_AGENT_TIMEOUT_SECONDS=45
# MAIN_AGENT_BEARER_TOKEN=
# A2UI_FORWARD_AUTHORIZATION=false
# A2UI_SELECTION_TTL_SECONDS=300
# A2UI_SELECTION_MAX_ENTRIES=100
# A2UI_PROXY_ALLOWED_ORIGINS=http://localhost:3001
# A2UI_FLOW_LOG_INCLUDE_PAYLOADS=false
# A2UI_EXPOSE_ERROR_DETAILS=false
# A2UI_A2A_URL=http://localhost:3001/api/a2a
# A2UI_A2A_TIMEOUT_SECONDS=45
